# ============================================
#  .gitignore — مریم قابل برند شخصی
#  تاریخ: آذر ۱۴۰۵
# ============================================

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- محیط و وابستگی‌ها ---
.env
.env.local
.env.*.local
.env.production
.env.staging
*.env

# --- سیستم‌عامل ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- ویرایشگرها و IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# --- فایل‌های موقت ---
*.tmp
*.temp
*.bak
*.old
*.log
*.cache
*.pid
*.seed

# --- سِکرت‌ها و کلیدها (اهمیت بحرانی) ---
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.pub
*credentials*
*secret*
*token*
*apikey*
*api-key*
google-credentials.json
service-account.json

# --- خروجی‌های build و cache ---
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
coverage/
.nyc_output/

# --- فایل‌های بزرگ/ویدیوی خام (در صورت نیاز در release قرار گیرند) ---
*.mp4.raw
*.mov.raw
*.psd
*.ai
*.sketch

# --- فایل‌های پروژه‌های محلی (Final Cut, Premiere, ...) ---
*.fcpxml
*.prproj
*.aep

# --- پیکربندی‌های شخصی ---
config.local.js
config.local.json

# --- اطلاعات حساس مراجع (هرگز در ریپو) ---
*.patient
*.client
clients-data/
patient-data/
