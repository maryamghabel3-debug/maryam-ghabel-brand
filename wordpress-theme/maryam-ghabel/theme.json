{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "color": {
            "custom": true,
            "customGradient": true,
            "customDuotone": true,
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "palette": [
                {
                    "name": "سرمه‌ای",
                    "slug": "navy",
                    "color": "#1B2845"
                },
                {
                    "name": "سرمه‌ای روشن",
                    "slug": "navy-light",
                    "color": "#2A3A5C"
                },
                {
                    "name": "سرمه‌ای تیره",
                    "slug": "navy-dark",
                    "color": "#131C30"
                },
                {
                    "name": "بژ",
                    "slug": "beige",
                    "color": "#E8DCC8"
                },
                {
                    "name": "بژ روشن",
                    "slug": "beige-light",
                    "color": "#F2EBDC"
                },
                {
                    "name": "بژ تیره",
                    "slug": "beige-dark",
                    "color": "#D4C3A8"
                },
                {
                    "name": "طلایی",
                    "slug": "gold",
                    "color": "#C9A87C"
                },
                {
                    "name": "طلایی تیره",
                    "slug": "gold-dark",
                    "color": "#A8895E"
                },
                {
                    "name": "مشکی نرم",
                    "slug": "soft-black",
                    "color": "#2A2A2A"
                },
                {
                    "name": "سفید",
                    "slug": "white",
                    "color": "#FFFFFF"
                }
            ],
            "gradients": [
                {
                    "name": "سرمه‌ای به تیره",
                    "slug": "navy-gradient",
                    "gradient": "linear-gradient(135deg, #1B2845 0%, #131C30 100%)"
                },
                {
                    "name": "طلایی به تیره",
                    "slug": "gold-gradient",
                    "gradient": "linear-gradient(135deg, #C9A87C 0%, #A8895E 100%)"
                },
                {
                    "name": "بژ به روشن",
                    "slug": "beige-gradient",
                    "gradient": "linear-gradient(135deg, #E8DCC8 0%, #F2EBDC 100%)"
                }
            ]
        },
        "typography": {
            "customFontSize": true,
            "customLineHeight": true,
            "fontSizes": [
                {
                    "name": "کوچک",
                    "slug": "small",
                    "size": "0.875rem"
                },
                {
                    "name": "متوسط",
                    "slug": "medium",
                    "size": "1.125rem"
                },
                {
                    "name": "بزرگ",
                    "slug": "large",
                    "size": "1.5rem"
                },
                {
                    "name": "بزرگ‌تر",
                    "slug": "x-large",
                    "size": "2rem"
                },
                {
                    "name": "غول‌پیکر",
                    "slug": "xx-large",
                    "size": "3rem"
                }
            ],
            "fontFamilies": [
                {
                    "name": "Vazirmatn",
                    "slug": "vazirmatn",
                    "fontFamily": "Vazirmatn, Tahoma, 'Segoe UI', sans-serif"
                },
                {
                    "name": "سیستم",
                    "slug": "system",
                    "fontFamily": "Tahoma, 'Segoe UI', sans-serif"
                }
            ]
        },
        "spacing": {
            "units": ["px", "em", "rem", "%", "vw", "vh"],
            "padding": true,
            "margin": true
        },
        "layout": {
            "contentSize": "840px",
            "wideSize": "1200px"
        }
    },
    "styles": {
        "color": {
            "background": "#F2EBDC",
            "text": "#2A2A2A"
        },
        "typography": {
            "fontFamily": "Vazirmatn, Tahoma, 'Segoe UI', sans-serif",
            "fontSize": "1rem",
            "lineHeight": "1.7"
        },
        "elements": {
            "h1": {
                "color": {
                    "text": "#1B2845"
                },
                "typography": {
                    "fontWeight": "700",
                    "lineHeight": "1.3",
                    "fontSize": "clamp(2rem, 5vw, 3.5rem)"
                }
            },
            "h2": {
                "color": {
                    "text": "#1B2845"
                },
                "typography": {
                    "fontWeight": "700",
                    "lineHeight": "1.3",
                    "fontSize": "clamp(1.75rem, 4vw, 2.5rem)"
                }
            },
            "h3": {
                "color": {
                    "text": "#1B2845"
                },
                "typography": {
                    "fontWeight": "700",
                    "fontSize": "1.5rem"
                }
            },
            "link": {
                "color": {
                    "text": "#A8895E"
                },
                ":hover": {
                    "color": {
                        "text": "#1B2845"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "#1B2845",
                    "text": "#E8DCC8"
                },
                "typography": {
                    "fontFamily": "Vazirmatn, Tahoma, sans-serif",
                    "fontWeight": "600"
                },
                "border": {
                    "radius": "8px"
                },
                "spacing": {
                    "padding": {
                        "top": "0.85rem",
                        "right": "1.75rem",
                        "bottom": "0.85rem",
                        "left": "1.75rem"
                    }
                },
                ":hover": {
                    "color": {
                        "background": "#C9A87C",
                        "text": "#1B2845"
                    }
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "fontWeight": "700",
                    "fontSize": "1.5rem"
                },
                "color": {
                    "text": "#1B2845"
                }
            },
            "core/navigation": {
                "typography": {
                    "fontSize": "1rem",
                    "fontWeight": "500"
                },
                "color": {
                    "text": "#1B2845"
                }
            },
            "core/post-title": {
                "typography": {
                    "fontWeight": "700",
                    "lineHeight": "1.3"
                },
                "color": {
                    "text": "#1B2845"
                }
            },
            "core/quote": {
                "border": {
                    "color": "#C9A87C",
                    "width": "0 4px 0 0",
                    "style": "solid"
                },
                "spacing": {
                    "padding": {
                        "right": "1.5rem"
                    }
                },
                "typography": {
                    "fontStyle": "italic"
                }
            },
            "core/button": {
                "border": {
                    "radius": "8px"
                }
            }
        }
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        },
        {
            "name": "sidebar",
            "title": "Sidebar",
            "area": "uncategorized"
        }
    ],
    "customTemplates": [
        {
            "name": "template-home",
            "title": "صفحه خانه",
            "postTypes": ["page"]
        },
        {
            "name": "template-services",
            "title": "صفحه خدمات",
            "postTypes": ["page"]
        },
        {
            "name": "template-about",
            "title": "صفحه درباره من",
            "postTypes": ["page"]
        },
        {
            "name": "template-booking",
            "title": "صفحه رزرو جلسه",
            "postTypes": ["page"]
        },
        {
            "name": "template-contact",
            "title": "صفحه تماس",
            "postTypes": ["page"]
        }
    ]
}
